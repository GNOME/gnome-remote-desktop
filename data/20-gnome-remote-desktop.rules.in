//
// DO NOT EDIT THIS FILE, it will be overwritten on update.
//
// Allow gnome-remote-desktop to enable/disable itself

polkit.addRule(function(action, subject) {
  if (action.id === "org.gnome.remotedesktop.enable-system-daemon" &&
      subject.user === "@GRD_USERNAME@")
    return polkit.Result.YES;

  if (action.id === "org.gnome.remotedesktop.configure-system-daemon" &&
      subject.user === "@GRD_USERNAME@")
    return polkit.Result.YES;

  if (action.id === "org.gnome.displaymanager.displayfactory.manage-user-displays" &&
      subject.user === "@GRD_USERNAME@" &&
      subject.system_unit === "gnome-remote-desktop.service")
    return polkit.Result.YES;

  return polkit.Result.NOT_HANDLED;
});
